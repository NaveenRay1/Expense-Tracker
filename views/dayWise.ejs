    <!-- ==================== JAVASCRIPT ==================== -->

    <script>

        document.addEventListener("DOMContentLoaded", function () {


            /*
             * ==========================================================
             * VARIABLES
             * ==========================================================
             */

            let currentDate = getToday();

            let requestNumber = 0;


            const prevButton =
                document.getElementById("prev-day");

            const nextButton =
                document.getElementById("next-day");

            const todayButton =
                document.getElementById("today-btn");

            const datePickerElement =
                document.getElementById("date-picker");

            const transactionsContainer =
                document.getElementById("transactions-container");

            const transactionsList =
                document.getElementById("morning");

            const emptyState =
                document.getElementById("empty-state");

            const errorState =
                document.getElementById("error-state");

            const retryButton =
                document.getElementById("retry-btn");

            const searchInput =
                document.getElementById("search-input");



            /*
             * ==========================================================
             * DATE HELPERS
             * ==========================================================
             */


            // Returns today's date at local midnight
            function getToday() {

                const now = new Date();

                return new Date(
                    now.getFullYear(),
                    now.getMonth(),
                    now.getDate()
                );

            }


            // Creates a safe local date
            function createLocalDate(year, month, day) {

                return new Date(
                    year,
                    month,
                    day,
                    12,
                    0,
                    0
                );

            }


            // Convert Date -> YYYY-MM-DD
            //
            // IMPORTANT:
            // We intentionally DO NOT use toISOString()
            // because that converts the date to UTC.

            function formatDateForApi(date) {

                const year =
                    date.getFullYear();

                const month =
                    String(date.getMonth() + 1)
                        .padStart(2, "0");

                const day =
                    String(date.getDate())
                        .padStart(2, "0");

                return `${year}-${month}-${day}`;
            }



            // Display date nicely

            function formatDisplayDate(date) {

                return date.toLocaleDateString(
                    "en-US",
                    {
                        year: "numeric",
                        month: "long",
                        day: "numeric"
                    }
                );

            }


            // Display weekday

            function formatDayName(date) {

                return date.toLocaleDateString(
                    "en-US",
                    {
                        weekday: "long"
                    }
                );

            }



            /*
             * ==========================================================
             * FLATPICKR
             * ==========================================================
             */

            const datePicker = flatpickr(
                "#date-picker",
                {

                    dateFormat: "Y-m-d",

                    defaultDate: currentDate,

                    allowInput: false,

                    onChange: function (selectedDates) {

                        if (!selectedDates.length) {
                            return;
                        }


                        const selected =
                            selectedDates[0];


                        /*
                         * Recreate the date using its local
                         * year/month/day so we don't get
                         * timezone shifts.
                         */

                        currentDate = createLocalDate(
                            selected.getFullYear(),
                            selected.getMonth(),
                            selected.getDate()
                        );


                        updateDisplayedDate();

                    }

                }
            );



            /*
             * ==========================================================
             * DATE BUTTONS
             * ==========================================================
             */


            // Previous day

            prevButton.addEventListener(
                "click",
                function () {

                    currentDate = createLocalDate(
                        currentDate.getFullYear(),
                        currentDate.getMonth(),
                        currentDate.getDate() - 1
                    );


                    datePicker.setDate(
                        currentDate,
                        false
                    );


                    updateDisplayedDate();

                }
            );



            // Next day

            nextButton.addEventListener(
                "click",
                function () {

                    currentDate = createLocalDate(
                        currentDate.getFullYear(),
                        currentDate.getMonth(),
                        currentDate.getDate() + 1
                    );


                    datePicker.setDate(
                        currentDate,
                        false
                    );


                    updateDisplayedDate();

                }
            );



            // Today

            todayButton.addEventListener(
                "click",
                function () {

                    currentDate = getToday();


                    datePicker.setDate(
                        currentDate,
                        false
                    );


                    updateDisplayedDate();

                }
            );



            /*
             * ==========================================================
             * UPDATE DISPLAY
             * ==========================================================
             */

            function updateDisplayedDate() {


                const displayDate =
                    formatDisplayDate(currentDate);


                const dayName =
                    formatDayName(currentDate);


                document.getElementById(
                    "current-date"
                ).textContent = displayDate;


                document.getElementById(
                    "day-of-week"
                ).textContent = dayName;


                document.getElementById(
                    "transactions-date"
                ).textContent = displayDate;


                loadTransactions();

            }



            /*
             * ==========================================================
             * LOAD TRANSACTIONS
             * ==========================================================
             */

            async function loadTransactions() {


                const dateStr =
                    formatDateForApi(currentDate);


                console.log(
                    "Loading daywise transactions:",
                    dateStr
                );


                /*
                 * Give every request a number.
                 *
                 * If the user clicks next/previous very quickly,
                 * an older request won't overwrite the newest date.
                 */

                const thisRequest =
                    ++requestNumber;


                showLoading();


                try {

                    const response =
                        await fetch(
                            `/expense/day-wise?date=${encodeURIComponent(dateStr)}`,
                            {
                                method: "GET",
                                credentials: "same-origin"
                            }
                        );


                    if (!response.ok) {

                        throw new Error(
                            `Request failed: ${response.status}`
                        );

                    }


                    const data =
                        await response.json();


                    /*
                     * Ignore old request responses.
                     */

                    if (
                        thisRequest !== requestNumber
                    ) {
                        return;
                    }


                    console.log(
                        "Daywise response:",
                        data
                    );


                    renderTransactions(data);

                }
                catch (error) {

                    console.error(
                        "Error fetching transactions:",
                        error
                    );


                    /*
                     * Don't show an old request's
                     * error over a newer request.
                     */

                    if (
                        thisRequest !== requestNumber
                    ) {
                        return;
                    }


                    showError();

                }

            }



            /*
             * ==========================================================
             * RENDER TRANSACTIONS
             * ==========================================================
             */

            function renderTransactions(data) {


                const transactions =
                    Array.isArray(data.transactions)
                        ? data.transactions
                        : [];


                /*
                 * Update summary values.
                 *
                 * || 0 prevents blank values.
                 */

                document.getElementById(
                    "totalIncome"
                ).textContent =
                    Number(data.totalIncome || 0).toLocaleString(
                        "en-IN"
                    );


                document.getElementById(
                    "totalExpense"
                ).textContent =
                    Number(data.totalExpense || 0).toLocaleString(
                        "en-IN"
                    );


                document.getElementById(
                    "netAmount"
                ).textContent =
                    Number(data.netAmount || 0).toLocaleString(
                        "en-IN"
                    );


                document.getElementById(
                    "totalTransactions"
                ).textContent =
                    Number(
                        data.transLength ??
                        transactions.length ??
                        0
                    );



                /*
                 * Clear previous transactions.
                 */

                transactionsList.innerHTML = "";



                /*
                 * No transactions
                 */

                if (transactions.length === 0) {

                    transactionsContainer.classList.add(
                        "hidden"
                    );

                    emptyState.classList.remove(
                        "hidden"
                    );

                    errorState.classList.add(
                        "hidden"
                    );

                    return;

                }



                /*
                 * Transactions exist.
                 */

                transactionsContainer.classList.remove(
                    "hidden"
                );

                emptyState.classList.add(
                    "hidden"
                );

                errorState.classList.add(
                    "hidden"
                );



                /*
                 * Render every transaction.
                 */

                transactions.forEach(function (transaction) {


                    /*
                     * Your Expense model has:
                     *
                     * description
                     * category
                     * amount
                     * type
                     * date
                     *
                     * It does NOT have "title".
                     *
                     * So use description first.
                     */

                    const description =
                        transaction.description ||
                        transaction.title ||
                        "Transaction";


                    const category =
                        transaction.category ||
                        "Other";


                    const amount =
                        Number(
                            transaction.amount || 0
                        );


                    const type =
                        transaction.type ||
                        "expense";



                    /*
                     * Format transaction time.
                     */

                    let time = "";

                    if (transaction.date) {

                        const transactionDate =
                            new Date(transaction.date);


                        if (
                            !isNaN(
                                transactionDate.getTime()
                            )
                        ) {

                            time =
                                transactionDate.toLocaleTimeString(
                                    "en-IN",
                                    {
                                        hour: "2-digit",
                                        minute: "2-digit",
                                        second: "2-digit"
                                    }
                                );

                        }

                    }



                    /*
                     * Income / expense styling.
                     */

                    const isIncome =
                        type.toLowerCase() === "income";


                    const amountClass =
                        isIncome
                            ? "text-success"
                            : "text-danger";


                    const sign =
                        isIncome
                            ? "+"
                            : "-";


                    const icon =
                        isIncome
                            ? "fa-arrow-up"
                            : "fa-arrow-down";


                    const iconBg =
                        isIncome
                            ? "bg-green-100"
                            : "bg-red-100";


                    const iconColor =
                        isIncome
                            ? "text-green-600"
                            : "text-red-600";



                    /*
                     * Create transaction element.
                     */

                    const transactionElement =
                        document.createElement("div");


                    transactionElement.className =
                        "trans flex items-center justify-between p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition";


                    /*
                     * Store searchable text.
                     */

                    transactionElement.dataset.search =
                        `${category} ${description} ${type}`.toLowerCase();



                    transactionElement.innerHTML = `

                        <div class="flex items-center">

                            <div
                                class="flex-shrink-0 h-12 w-12 ${iconBg} rounded-lg flex items-center justify-center"
                            >
                                <i
                                    class="fas ${icon} ${iconColor}"
                                ></i>
                            </div>

                            <div class="ml-4">

                                <div class="text-sm font-medium text-gray-900">
                                    ${escapeHtml(category)}
                                </div>

                                <div class="text-sm text-gray-500">
                                    ${escapeHtml(description)}
                                </div>

                            </div>

                        </div>


                        <div class="text-right">

                            <div class="text-sm font-medium ${amountClass}">
                                ${sign}₹${amount.toLocaleString("en-IN")}
                            </div>

                            <div class="text-sm text-gray-500">
                                ${time}
                            </div>

                        </div>

                    `;


                    transactionsList.appendChild(
                        transactionElement
                    );

                });



                /*
                 * Apply current search after rendering.
                 */

                applySearch();

            }



            /*
             * ==========================================================
             * SEARCH
             * ==========================================================
             */

            searchInput.addEventListener(
                "input",
                function () {

                    applySearch();

                }
            );


            function applySearch() {


                const searchTerm =
                    searchInput.value
                        .trim()
                        .toLowerCase();


                const transactions =
                    document.querySelectorAll(
                        ".trans"
                    );


                transactions.forEach(
                    function (transaction) {


                        const searchableText =
                            transaction.dataset.search ||
                            transaction.textContent.toLowerCase();


                        if (
                            searchableText.includes(
                                searchTerm
                            )
                        ) {

                            transaction.style.display =
                                "flex";

                        }
                        else {

                            transaction.style.display =
                                "none";

                        }

                    }
                );

            }



            /*
             * ==========================================================
             * LOADING STATE
             * ==========================================================
             */

            function showLoading() {


                transactionsContainer.classList.remove(
                    "hidden"
                );

                emptyState.classList.add(
                    "hidden"
                );

                errorState.classList.add(
                    "hidden"
                );


                transactionsList.innerHTML = `

                    <div class="flex justify-center items-center py-12">

                        <div class="text-center">

                            <i
                                class="fas fa-spinner fa-spin text-3xl text-primary mb-3"
                            ></i>

                            <p class="text-gray-500">
                                Loading transactions...
                            </p>

                        </div>

                    </div>

                `;


                /*
                 * Reset summary while loading.
                 */

                document.getElementById(
                    "totalIncome"
                ).textContent = "0";


                document.getElementById(
                    "totalExpense"
                ).textContent = "0";


                document.getElementById(
                    "netAmount"
                ).textContent = "0";


                document.getElementById(
                    "totalTransactions"
                ).textContent = "0";

            }



            /*
             * ==========================================================
             * ERROR STATE
             * ==========================================================
             */

            function showError() {

                transactionsContainer.classList.add(
                    "hidden"
                );

                emptyState.classList.add(
                    "hidden"
                );

                errorState.classList.remove(
                    "hidden"
                );

            }



            /*
             * ==========================================================
             * ESCAPE HTML
             * ==========================================================
             *
             * Prevents transaction text from injecting HTML.
             */

            function escapeHtml(value) {

                return String(value)
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");

            }



            /*
             * ==========================================================
             * RETRY
             * ==========================================================
             */

            retryButton.addEventListener(
                "click",
                function () {

                    loadTransactions();

                }
            );



            /*
             * ==========================================================
             * INITIAL LOAD
             * ==========================================================
             */

            updateDisplayedDate();

        });

    </script>

</body>

</html>