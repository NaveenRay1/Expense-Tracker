<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <script src="https://cdn.tailwindcss.com"></script>

    <title>Expense Reports</title>

    <style>
        @media print {

            header,
            footer,
            nav,
            button,
            .no-print {
                display: none !important;
            }

            body {
                background: white !important;
            }

            main {
                width: 100% !important;
                max-width: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
            }

            .shadow,
            .shadow-sm,
            .shadow-md,
            .shadow-lg {
                box-shadow: none !important;
            }

            .bg-white {
                background: white !important;
            }

            .report-section,
            .card {
                break-inside: avoid;
                page-break-inside: avoid;
            }
        }
    </style>
</head>

<body class="bg-gray-50 text-gray-800">

    <!-- MAIN -->
    <main class="container mx-auto px-4 py-10 max-w-7xl">

        <!-- PAGE HEADER -->
        <div class="mb-8">

            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">

                <div>
                    <h1 class="text-3xl font-extrabold text-gray-900">
                        Expense Reports
                    </h1>

                    <p class="text-gray-500 mt-2">
                        View and download your financial reports
                    </p>
                </div>

                <div class="bg-yellow-100 text-yellow-700 px-4 py-2 rounded-lg font-semibold">
                    👑 Premium Report
                </div>

            </div>

        </div>


        <!-- ========================= -->
        <!-- MONTHLY REPORT -->
        <!-- ========================= -->

        <section class="bg-white shadow-lg rounded-2xl p-6 mb-10 report-section">

            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">

                <div>
                    <h2 class="text-2xl font-bold text-gray-800">
                        Monthly Report
                    </h2>

                    <p class="text-gray-500 mt-1">
                        View transactions for a specific month
                    </p>
                </div>


                <!-- MONTH / YEAR FILTER -->
                <form
                    method="GET"
                    action="/reports"
                    class="flex flex-wrap items-center gap-3 no-print"
                >

                    <!-- MONTH -->
                    <select
                        name="month"
                        class="border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500"
                    >

                        <% for (let m = 1; m <= 12; m++) { %>

                            <option
                                value="<%= m %>"
                                <%= Number(selectedMonth) === m ? 'selected' : '' %>
                            >
                                <%= new Date(2000, m - 1, 1).toLocaleString('en-US', { month: 'long' }) %>
                            </option>

                        <% } %>

                    </select>


                    <!-- YEAR -->
                    <select
                        name="year"
                        class="border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500"
                    >

                        <% for (let y = new Date().getFullYear(); y >= new Date().getFullYear() - 10; y--) { %>

                            <option
                                value="<%= y %>"
                                <%= Number(selectedYear) === y ? 'selected' : '' %>
                            >
                                <%= y %>
                            </option>

                        <% } %>

                    </select>


                    <button
                        type="submit"
                        class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-5 py-2 rounded-lg transition"
                    >
                        Apply
                    </button>

                </form>

            </div>


            <!-- SELECTED MONTH -->
            <div class="bg-indigo-50 rounded-xl p-5 mb-6">

                <h3 class="text-xl font-bold text-indigo-700">
                    <%= selectedMonthName %> <%= selectedYear %>
                </h3>

                <p class="text-gray-500 mt-1">
                    Monthly financial summary
                </p>

            </div>


            <!-- MONTHLY SUMMARY -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-8">

                <!-- INCOME -->
                <div class="bg-green-50 rounded-xl p-5 border border-green-100">

                    <p class="text-gray-500 text-sm">
                        Total Income
                    </p>

                    <p class="text-2xl font-bold text-green-600 mt-2">
                        ₹<%= Number(monthlyIncome || 0).toLocaleString('en-IN') %>
                    </p>

                </div>


                <!-- EXPENSE -->
                <div class="bg-red-50 rounded-xl p-5 border border-red-100">

                    <p class="text-gray-500 text-sm">
                        Total Expense
                    </p>

                    <p class="text-2xl font-bold text-red-600 mt-2">
                        ₹<%= Number(monthlyExpense || 0).toLocaleString('en-IN') %>
                    </p>

                </div>


                <!-- SAVINGS -->
                <div class="bg-blue-50 rounded-xl p-5 border border-blue-100">

                    <p class="text-gray-500 text-sm">
                        Savings
                    </p>

                    <p class="text-2xl font-bold text-blue-600 mt-2">
                        ₹<%= Number(monthlySavings || 0).toLocaleString('en-IN') %>
                    </p>

                </div>

            </div>


            <!-- MONTHLY TRANSACTIONS -->
            <div class="overflow-x-auto">

                <table class="min-w-full text-sm text-left border border-gray-200 rounded-lg overflow-hidden">

                    <thead class="bg-indigo-600 text-white">

                        <tr>

                            <th class="px-6 py-3">
                                Date
                            </th>

                            <th class="px-6 py-3">
                                Description
                            </th>

                            <th class="px-6 py-3">
                                Type
                            </th>

                            <th class="px-6 py-3">
                                Amount
                            </th>

                        </tr>

                    </thead>


                    <tbody class="divide-y divide-gray-200">

                        <% if (monthlyTransactions && monthlyTransactions.length > 0) { %>

                            <% monthlyTransactions.forEach(transaction => { %>

                                <tr class="hover:bg-gray-50">

                                    <td class="px-6 py-3">
                                        <%= transaction.date
                                            ? new Date(transaction.date).toLocaleDateString('en-IN')
                                            : '' %>
                                    </td>


                                    <td class="px-6 py-3 font-medium">
                                        <%= transaction.description || '' %>
                                    </td>


                                    <td class="px-6 py-3">

                                        <% if (transaction.type === 'income') { %>

                                            <span class="text-green-600 font-semibold">
                                                Income
                                            </span>

                                        <% } else { %>

                                            <span class="text-red-600 font-semibold">
                                                Expense
                                            </span>

                                        <% } %>

                                    </td>


                                    <td class="px-6 py-3 font-bold">

                                        <% if (transaction.type === 'income') { %>

                                            <span class="text-green-600">
                                                +₹<%= Number(transaction.amount || 0).toLocaleString('en-IN') %>
                                            </span>

                                        <% } else { %>

                                            <span class="text-red-600">
                                                -₹<%= Number(transaction.amount || 0).toLocaleString('en-IN') %>
                                            </span>

                                        <% } %>

                                    </td>

                                </tr>

                            <% }) %>

                        <% } else { %>

                            <tr>

                                <td
                                    colspan="4"
                                    class="px-6 py-12 text-center text-gray-500"
                                >
                                    No transactions found for this month.
                                </td>

                            </tr>

                        <% } %>

                    </tbody>

                </table>

            </div>


            <!-- MONTHLY DOWNLOAD -->
            <div class="flex justify-end mt-6 no-print">

                <a
                    href="/report/monthly/download?month=<%= selectedMonth %>&year=<%= selectedYear %>"
                    class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-6 py-3 rounded-xl shadow-md transition"
                >
                    ⬇ Download Monthly Report
                </a>

            </div>

        </section>



        <!-- ========================= -->
        <!-- YEARLY REPORT -->
        <!-- ========================= -->

        <section class="bg-white shadow-lg rounded-2xl p-6 mb-10 report-section">

            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">

                <div>

                    <h2 class="text-2xl font-bold text-gray-800">
                        Yearly Report
                    </h2>

                    <p class="text-gray-500 mt-1">
                        Monthly breakdown for <%= selectedYear %>
                    </p>

                </div>

            </div>


            <!-- YEARLY SUMMARY -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-8">

                <div class="bg-green-50 rounded-xl p-5 border border-green-100">

                    <p class="text-gray-500 text-sm">
                        Yearly Income
                    </p>

                    <p class="text-2xl font-bold text-green-600 mt-2">
                        ₹<%= Number(yearlyIncome || 0).toLocaleString('en-IN') %>
                    </p>

                </div>


                <div class="bg-red-50 rounded-xl p-5 border border-red-100">

                    <p class="text-gray-500 text-sm">
                        Yearly Expense
                    </p>

                    <p class="text-2xl font-bold text-red-600 mt-2">
                        ₹<%= Number(yearlyExpense || 0).toLocaleString('en-IN') %>
                    </p>

                </div>


                <div class="bg-blue-50 rounded-xl p-5 border border-blue-100">

                    <p class="text-gray-500 text-sm">
                        Yearly Savings
                    </p>

                    <p class="text-2xl font-bold text-blue-600 mt-2">
                        ₹<%= Number(yearlySavings || 0).toLocaleString('en-IN') %>
                    </p>

                </div>

            </div>


            <!-- YEARLY TABLE -->
            <div class="overflow-x-auto">

                <table class="min-w-full text-sm text-left border border-gray-200 rounded-lg overflow-hidden">

                    <thead class="bg-green-600 text-white">

                        <tr>

                            <th class="px-6 py-3">
                                Month
                            </th>

                            <th class="px-6 py-3">
                                Income
                            </th>

                            <th class="px-6 py-3">
                                Expense
                            </th>

                            <th class="px-6 py-3">
                                Savings
                            </th>

                        </tr>

                    </thead>


                    <tbody class="divide-y divide-gray-200">

                        <% if (monthlyReport && monthlyReport.length > 0) { %>

                            <% monthlyReport.forEach(month => { %>

                                <tr class="hover:bg-gray-50">

                                    <td class="px-6 py-3 font-medium">
                                        <%= month.month %>
                                    </td>

                                    <td class="px-6 py-3 text-green-600 font-bold">
                                        ₹<%= Number(month.income || 0).toLocaleString('en-IN') %>
                                    </td>

                                    <td class="px-6 py-3 text-red-600 font-bold">
                                        ₹<%= Number(month.expense || 0).toLocaleString('en-IN') %>
                                    </td>

                                    <td class="px-6 py-3 text-blue-600 font-bold">
                                        ₹<%= Number(month.savings || 0).toLocaleString('en-IN') %>
                                    </td>

                                </tr>

                            <% }) %>

                        <% } else { %>

                            <tr>

                                <td
                                    colspan="4"
                                    class="px-6 py-12 text-center text-gray-500"
                                >
                                    No transactions found for this year.
                                </td>

                            </tr>

                        <% } %>

                    </tbody>

                </table>

            </div>


            <!-- YEARLY DOWNLOAD -->
            <div class="flex justify-end mt-6 no-print">

                <a
                    href="/report/yearly/download?year=<%= selectedYear %>"
                    class="bg-green-600 hover:bg-green-700 text-white font-semibold px-6 py-3 rounded-xl shadow-md transition"
                >
                    ⬇ Download Yearly Report
                </a>

            </div>

        </section>

    </main>

</body>

</html>