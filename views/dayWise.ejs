<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>ExpenseTracker - Daywise Transactions</title>

    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Font Awesome -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    >

    <!-- Flatpickr -->
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css"
    >

    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    <style>
        :root {
            --primary: #4f46e5;
            --primary-dark: #4338ca;
            --success: #10b981;
            --danger: #ef4444;
            --info: #3b82f6;
            --dark: #4338ca;
        }

        .loading {
            opacity: 0.6;
            pointer-events: none;
        }
    </style>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#4f46e5',
                        'primary-dark': '#4338ca',
                        success: '#10b981',
                        danger: '#ef4444',
                        info: '#3b82f6'
                    }
                }
            }
        };
    </script>
</head>


<body class="bg-gray-50 min-h-screen">

    <!-- ==================== NAVBAR ==================== -->

    <div>
        <%- include('partials/navbar', { user: user }) %>
    </div>


    <!-- ==================== MAIN ==================== -->

    <main class="container mx-auto px-4 py-8">

        <!-- Page Header -->

        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8">

            <div>
                <h2 class="text-2xl font-bold text-gray-800">
                    Daywise Transactions
                </h2>

                <p class="text-gray-600 mt-1">
                    View and manage your daily financial activities
                </p>
            </div>


            <!-- Search -->

            <div class="mt-4 md:mt-0">

                <div class="flex items-center space-x-2 bg-white rounded-lg shadow-sm px-4 py-2">

                    <i class="fas fa-search text-gray-400"></i>

                    <input
                        type="text"
                        id="search-input"
                        placeholder="Search transactions..."
                        class="outline-none bg-transparent w-64"
                    >

                </div>

            </div>

        </div>



        <!-- ==================== DATE NAVIGATION ==================== -->

        <section class="bg-white rounded-xl shadow-sm p-6 mb-8">

            <div class="flex flex-col md:flex-row justify-between items-center">

                <!-- Previous / Current / Next -->

                <div class="flex items-center space-x-4 mb-4 md:mb-0">

                    <!-- Previous -->

                    <button
                        id="prev-day"
                        type="button"
                        aria-label="Previous day"
                        class="w-10 h-10 flex items-center justify-center rounded-full border border-gray-300 hover:bg-gray-100 transition"
                    >
                        <i class="fas fa-chevron-left text-gray-600"></i>
                    </button>


                    <!-- Current date -->

                    <div class="text-center min-w-[190px]">

                        <h3
                            id="current-date"
                            class="text-xl font-bold text-gray-800"
                        >
                            Loading...
                        </h3>

                        <p
                            id="day-of-week"
                            class="text-gray-500"
                        >
                            --
                        </p>

                    </div>


                    <!-- Next -->

                    <button
                        id="next-day"
                        type="button"
                        aria-label="Next day"
                        class="w-10 h-10 flex items-center justify-center rounded-full border border-gray-300 hover:bg-gray-100 transition"
                    >
                        <i class="fas fa-chevron-right text-gray-600"></i>
                    </button>

                </div>



                <!-- Today + Calendar -->

                <div class="flex items-center space-x-4">

                    <button
                        id="today-btn"
                        type="button"
                        class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary-dark transition"
                    >
                        Today
                    </button>


                    <div class="relative">

                        <input
                            type="text"
                            id="date-picker"
                            class="w-48 px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent cursor-pointer"
                            placeholder="Select Date"
                            readonly
                        >

                        <i
                            class="fas fa-calendar-alt absolute right-3 top-3 text-gray-400 pointer-events-none"
                        ></i>

                    </div>

                </div>

            </div>

        </section>



        <!-- ==================== DAILY SUMMARY ==================== -->

        <section class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">


            <!-- Total Income -->

            <div class="bg-white rounded-xl shadow-sm p-6">

                <div class="flex justify-between items-start">

                    <div>

                        <p class="text-gray-500 text-sm">
                            Total Income
                        </p>

                        <h3 class="text-2xl font-bold text-success mt-1">
                            ₹<span id="totalIncome">0</span>
                        </h3>

                    </div>

                    <div class="bg-green-100 text-success p-3 rounded-lg">

                        <i class="fas fa-arrow-up text-lg"></i>

                    </div>

                </div>

            </div>



            <!-- Total Expenses -->

            <div class="bg-white rounded-xl shadow-sm p-6">

                <div class="flex justify-between items-start">

                    <div>

                        <p class="text-gray-500 text-sm">
                            Total Expenses
                        </p>

                        <h3 class="text-2xl font-bold text-danger mt-1">
                            ₹<span id="totalExpense">0</span>
                        </h3>

                    </div>

                    <div class="bg-red-100 text-danger p-3 rounded-lg">

                        <i class="fas fa-arrow-down text-lg"></i>

                    </div>

                </div>

            </div>



            <!-- Net Amount -->

            <div class="bg-white rounded-xl shadow-sm p-6">

                <div class="flex justify-between items-start">

                    <div>

                        <p class="text-gray-500 text-sm">
                            Net Amount
                        </p>

                        <h3 class="text-2xl font-bold text-info mt-1">
                            ₹<span id="netAmount">0</span>
                        </h3>

                    </div>

                    <div class="bg-blue-100 text-info p-3 rounded-lg">

                        <i class="fas fa-wallet text-lg"></i>

                    </div>

                </div>

            </div>



            <!-- Transaction Count -->

            <div class="bg-white rounded-xl shadow-sm p-6">

                <div class="flex justify-between items-start">

                    <div>

                        <p class="text-gray-500 text-sm">
                            Transactions
                        </p>

                        <h3
                            id="totalTransactions"
                            class="text-2xl font-bold text-gray-800 mt-1"
                        >
                            0
                        </h3>

                    </div>

                    <div class="bg-purple-100 text-purple-600 p-3 rounded-lg">

                        <i class="fas fa-receipt text-lg"></i>

                    </div>

                </div>

                <p class="text-gray-600 text-sm mt-2 flex items-center">

                    <i class="fas fa-clock mr-1"></i>

                    All day

                </p>

            </div>

        </section>



        <!-- ==================== TRANSACTIONS ==================== -->

        <section class="bg-white rounded-xl shadow-sm overflow-hidden">


            <!-- Header -->

            <div class="px-6 py-4 border-b border-gray-200">

                <h3 class="text-lg font-semibold text-gray-800">

                    Transactions for

                    <span id="transactions-date">
                        Loading...
                    </span>

                </h3>

            </div>



            <!-- Transactions -->

            <div id="transactions-container">

                <div class="p-6">


                    <!-- Today label -->

                    <div class="flex items-center mb-4">

                        <div class="w-3 h-3 bg-orange-400 rounded-full mr-3"></div>

                        <h4 class="font-medium text-gray-700">
                            Transactions
                        </h4>

                    </div>


                    <!-- Actual transaction list -->

                    <div
                        id="morning"
                        class="space-y-4"
                    >
                    </div>


                </div>

            </div>



            <!-- Empty State -->

            <div
                id="empty-state"
                class="hidden p-12 text-center"
            >

                <i class="fas fa-receipt text-4xl text-gray-300 mb-4"></i>

                <h3 class="text-lg font-medium text-gray-700 mb-2">
                    No transactions for this day
                </h3>

                <p class="text-gray-500">
                    You haven't recorded any transactions for this date.
                </p>

            </div>


            <!-- Error State -->

            <div
                id="error-state"
                class="hidden p-12 text-center"
            >

                <i class="fas fa-exclamation-circle text-4xl text-red-300 mb-4"></i>

                <h3 class="text-lg font-medium text-gray-700 mb-2">
                    Could not load transactions
                </h3>

                <p class="text-gray-500 mb-4">
                    Something went wrong while loading this date.
                </p>

                <button
                    id="retry-btn"
                    type="button"
                    class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary-dark"
                >
                    Try Again
                </button>

            </div>

        </section>

    </main>



    <!-- ==================== FOOTER ==================== -->

    <footer class="bg-gray-800 text-white mt-12">

        <div class="container mx-auto px-4 py-8">

            <div class="grid grid-cols-1 md:grid-cols-4 gap-8">


                <!-- About -->

                <div>

