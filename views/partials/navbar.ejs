<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>ExpenseTracker</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>

<body class="bg-gray-50 font-sans">

    <!-- ================= NAVBAR ================= -->

    <header class="bg-white shadow-sm">

        <div class="container mx-auto px-4 py-4">

            <div class="flex justify-between items-center">

                <!-- LOGO -->
                <a href="/" class="flex items-center space-x-2">

                    <i class="fas fa-chart-pie text-indigo-600 text-xl"></i>

                    <h1 class="text-xl font-bold text-gray-800">
                        ExpenseTracker
                    </h1>

                </a>


                <!-- RIGHT SIDE -->
                <div class="flex items-center space-x-5">

                    <!-- NAVIGATION -->
                    <nav class="flex items-center space-x-6">

                        <!-- DASHBOARD -->
                        <a href="/" class="text-gray-700 hover:text-indigo-600 transition duration-200">
                            Dashboard
                        </a>


                        <!-- TRANSACTIONS -->
                        <a href="/transactions" class="text-gray-700 hover:text-indigo-600 transition duration-200">
                            Transactions
                        </a>


                        <!-- DAILY -->
                        <% if (!user || !user.isPremium) { %>

                            <button type="button" onclick="alert('Only for Premium User')"
                                class="text-gray-700 hover:text-indigo-600 transition duration-200 cursor-pointer">
                                Daily
                            </button>

                            <% } else { %>

                                <a href="/dayWise" class="text-gray-700 hover:text-indigo-600 transition duration-200">
                                    Daily
                                </a>

                                <% } %>


                                    <!-- LEADERBOARD -->
                                    <% if (!user.isPremium) { %>

                                        <div onclick="alert('Only for Premium User')"
                                            class="cursor-pointer text-gray-700 hover:text-indigo-600 transition duration-200">
                                            leaderboard
                                        </div>

                                        <% } else { %>

                                            <a href="/leaderboard"
                                                class="text-gray-700 hover:text-indigo-600 transition duration-200">
                                                leaderboard
                                            </a>

                                            <% } %>


                                                <!-- REPORTS -->

                                                <% if (!user.isPremium) { %>

                                                    <div onclick="alert('Only for Premium User')"
                                                        class="cursor-pointer text-gray-700 hover:text-indigo-600 transition duration-200">
                                                        Reports
                                                    </div>

                                                    <% } else { %>

                                                        <a href="/reports"
                                                            class="text-gray-700 hover:text-indigo-600 transition duration-200">
                                                            Reports
                                                        </a>

                                                        <% } %>


                                                            <!-- SETTINGS -->

                                                            <a href="/settings"
                                                                class="text-gray-700 hover:text-indigo-600 transition duration-200">
                                                                Settings
                                                            </a>

                    </nav>


                    <!-- USER PROFILE / AVATAR -->
                    <a href="/settings" title="Open Profile"
                        class="w-10 h-10 rounded-full bg-indigo-600 flex items-center justify-center text-white font-bold uppercase hover:bg-indigo-700 transition duration-200">

                        <%= user?.userName ? user.userName.substring(0, 2).toUpperCase() : "U" %>

                    </a>


                    <!-- PREMIUM / UPGRADE -->
                    <% if (user && user.isPremium) { %>

                        <!-- PREMIUM USER -->
                        <div
                            class="h-10 px-4 bg-yellow-500 rounded-lg flex items-center justify-center text-white font-bold">
                            <i class="fas fa-crown mr-2"></i>
                            Premium
                        </div>

                        <% } else { %>

                            <!-- NON PREMIUM USER -->
                            <button type="button" id="upgradeBtn"
                                class="w-24 h-10 cursor-pointer bg-indigo-600 hover:bg-indigo-700 rounded-lg flex items-center justify-center text-white font-bold transition duration-200">
                                Upgrade
                            </button>

                            <% } %>

                </div>

            </div>

        </div>

    </header>


    <!-- ================= CASHFREE ================= -->

    <% if (!user || !user.isPremium) { %>

        <script src="https://sdk.cashfree.com/js/v3/cashfree.js"></script>

        <script>

            document.addEventListener("DOMContentLoaded", function () {

                const upgradeBtn =
                    document.getElementById("upgradeBtn");

                if (!upgradeBtn) return;


                upgradeBtn.addEventListener("click", async function () {

                    upgradeBtn.disabled = true;

                    upgradeBtn.textContent = "Loading...";


                    try {

                        // Create Cashfree order
                        const res = await fetch("/purchase/buy", {
                            method: "POST"
                        });


                        const data = await res.json();


                        // Check whether order was created
                        if (!res.ok || !data.payment_session_id) {

                            console.error("Payment error:", data);

                            alert(
                                data.message ||
                                data.msg ||
                                "Could not start payment. Please try again."
                            );

                            upgradeBtn.disabled = false;
                            upgradeBtn.textContent = "Upgrade";

                            return;
                        }


                        // Open Cashfree
                        const cashfree = Cashfree({
                            mode: "sandbox"
                        });


                        await cashfree.checkout({

                            paymentSessionId:
                                data.payment_session_id,

                            redirectTarget: "_self"

                        });

                    }


                    catch (err) {

                        console.error(
                            "Payment init failed:",
                            err
                        );

                        alert(
                            "Something went wrong starting payment."
                        );

                        upgradeBtn.disabled = false;
                        upgradeBtn.textContent = "Upgrade";

                    }

                });

            });

        </script>

        <% } %>

</body>

</html>